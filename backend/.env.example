# Praxia Marketing — local config
OPENAI_API_KEY=sk-...              # used for message personalization (same key as the app)
MARKETING_MODEL=gpt-4o-mini        # cheap + good for outreach copy

# Gmail sending (SMTP + App Password). Create at: Google Account -> Security ->
# 2-Step Verification -> App passwords. Paste the 16-char password (spaces ok).
SMTP_USER=praxiaaistudios@gmail.com
SMTP_APP_PASSWORD=

# Outreach identity + call-to-action
FROM_NAME=Praxia AI Studios
PUBLIC_EMAIL=praxiaaistudios@gmail.com
WHATSAPP=+91 88277 69501
BOOKING_LINK=                      # optional: your Calendly / booking URL
DEMO_VIDEO=                        # optional: public link to the demo video
DAILY_SEND_CAP=200

# --- Growth Studio (social presence engine) ---
GROWTH_MODEL=gpt-4o                 # strategy + copywriting brain
IMAGE_MODEL=gpt-image-1             # post-graphic generator (falls back to dall-e-3)
BRAND_HANDLE=@praxiaaistudios
WEBSITE=praxiaaistudios.in

# Auto-posting is OFF until you connect a platform AND set AUTO_POST=true.
# Until then every post waits in the calendar for one-tap manual posting.
AUTO_POST=false
PUBLIC_BASE_URL=                    # e.g. https://xxxx.ngrok.app  (needed so Instagram can fetch images)

# Instagram. Pick a connection method:
#   IG_API=instagram  -> Instagram Login, NO Facebook Page needed (recommended).
#       Paste FB_APP_SECRET (Meta app -> Settings -> Basic) and IG_ACCESS_TOKEN (Instagram product
#       -> API setup with Instagram login -> Generate token), then run:  python -m app.setup_ig
#   IG_API=facebook   -> Facebook Login, IG linked to a Facebook Page.
#       Paste FB_APP_ID + FB_APP_SECRET + a short-lived IG_ACCESS_TOKEN (Graph API Explorer),
#       then run:  python -m app.setup_ig
# setup_ig fills IG_USER_ID and swaps in a long-lived (~60-day) token for you.
IG_API=instagram
FB_APP_ID=
FB_APP_SECRET=
IG_USER_ID=
IG_ACCESS_TOKEN=

# YouTube (Data API v3, OAuth). Create an app in Google Cloud, grant youtube.upload,
# then exchange for a refresh token.
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# Cloudinary — throwaway pass-through so Instagram can fetch the reel video.
# The reel is uploaded for ~60s during publishing, then deleted. Nothing is kept.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Pexels (free) — real stock photos blended with AI visuals. Get a key at pexels.com/api.
PEXELS_API_KEY=

# Reel voiceover (OpenAI TTS)
TTS_VOICE=onyx
TTS_MODEL=tts-1-hd
